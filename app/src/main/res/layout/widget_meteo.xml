<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/meteo_city"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#1A73E8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            tools:ignore="RtlSymmetry" />

        <ImageButton
            android:id="@+id/meteo_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/refresh_button_bg"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_refresh"
            android:contentDescription="@string/refresh" />

    </LinearLayout>

    <ImageView
        android:id="@+id/meteo_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:contentDescription="@string/widget_label" />

    <TextView
        android:id="@+id/meteo_placeholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/loading"
        android:textColor="#222222"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/meteo_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:background="#AAFFFFFF"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textColor="#222222"
        android:textSize="11sp"
        tools:ignore="RtlSymmetry" />

</LinearLayout>
